# ========== BASE ==========
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/agenda_app_db
JWT_SECRET=genera_un_seguro_aqui
DB_SSL_REJECT_UNAUTHORIZED=true
WEBHOOK_RATE_LIMIT_MAX=30
INCLUDE_ERROR_DETAILS=false

# ========== CORS ==========
# Use dominios específicos. No uses * en producción.
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
# URL del frontend (usado en redirects OAuth, CSP, etc.)
FRONTEND_URL=https://tudominio.com
# Forzar HTTPS (recomendado en producción detrás de proxy SSL)
FORCE_HTTPS=true

# ========== GOOGLE OAUTH (Sign in with Google) ==========
# ID del cliente OAuth 2.0 de Google Cloud Console
# Debe estar configurado con JavaScript origins autorizados: tu dominio
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://tudominio.com/api/auth/google/callback
GOOGLE_CALENDAR_CALLBACK_URL=https://tudominio.com/api/auth/google/calendar/callback

# ========== TURNSTILE (Cloudflare CAPTCHA) ==========
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ========== STRIPE (pagos internacionales en USD) ==========
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
STRIPE_WEBHOOK_SECRET=

# ========== MERCADOPAGO ==========
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_CURRENCY=UYU
MP_LOCALE=es-UY
MP_COUNTRY=UY

# ========== PLANES ==========
PLAN_BASICO_PRICE=400
PLAN_BASICO_PRICE_USD=10
PLAN_BASICO_PROMO_PRICE=280
PLAN_BASICO_PROMO_PRICE_USD=7
PLAN_ESTANDAR_PRICE=760
PLAN_ESTANDAR_PRICE_USD=19
PLAN_ESTANDAR_PROMO_PRICE=560
PLAN_ESTANDAR_PROMO_PRICE_USD=14
PLAN_PREMIUM_PRICE=1160
PLAN_PREMIUM_PRICE_USD=29
PLAN_PREMIUM_PROMO_PRICE=840
PLAN_PREMIUM_PROMO_PRICE_USD=21
PLAN_PROMO_MONTHS=3

# ========== SMTP (email notifications) ==========
SMTP_SERVICE=Gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password

# ========== TWILIO (WhatsApp) ==========
# Número de WhatsApp Business verificado en Twilio (con código de país, ej: +14155238886)
TWILIO_WHATSAPP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ========== PUSH NOTIFICATIONS ==========
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ========== RATE LIMITING ==========
LOGIN_RATE_LIMIT_MAX=50
APPOINTMENT_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=3

# ========== OPCIONAL ==========
BASE_URL=https://tudominio.com
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
BCRYPT_ROUNDS=12
JWT_ALGORITHM=HS256
METRICS_ENABLED=true
SWAGGER_UI_ENABLED=true
SWAGGER_BASIC_AUTH_USER=admin
SWAGGER_BASIC_AUTH_PASS=tu-password-segura
SWAGGER_UI_ROUTE=/api-docs
SWAGGER_UI_JSON_ROUTE=/api-docs.json
METRICS_BASIC_AUTH_USER=metrics
METRICS_BASIC_AUTH_PASS=tu-password-segura
SEED_DEMO=false
DB_POOL_MAX=30

# ========== TEST ==========
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5433/agenda_app_test
